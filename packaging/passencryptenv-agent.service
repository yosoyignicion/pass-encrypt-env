[Unit]
Description=pass-encrypt-env — agente de bóveda (desbloqueo de sesión)
Documentation=https://github.com/yosoyignicion/pass-encrypt-env
PartOf=graphical-session.target
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/passenv-agent --delay 5
Environment=PYTHONUNBUFFERED=1
# El pop-up GTK necesita el entorno gráfico de la sesión.
PassEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS
Restart=on-failure
RestartSec=5

# Endurecimiento. Nota: NO se fija ProtectHome porque el agente debe leer/escribir
# la bóveda en $HOME (~/.config/pass-encrypt-env/).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=graphical-session.target
